{
  "name": "lingualoop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--require ./node-compat.cjs\" vite",
    "build": "vue-tsc -b && NODE_OPTIONS=\"--require ./node-compat.cjs\" vite build",
    "preview": "NODE_OPTIONS=\"--require ./node-compat.cjs\" vite preview",
    "test:navigation": "playwright test",
    "test:vocabulary": "node --experimental-strip-types --test tests/vocabulary.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
